{
    "id": "io.github.l1br3_io.CosmicExtDropterm",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "25.08",
    "sdk": "org.freedesktop.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "base": "com.system76.Cosmic.BaseApp",
    "base-version": "stable",
    "finish-args": [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--share=ipc",
        "--device=dri",
        "--filesystem=host",
        "--talk-name=com.system76.CosmicSettingsDaemon",
        "--own-name=io.github.l1br3_io.CosmicExtDropterm",
        "--talk-name=io.github.l1br3_io.CosmicExtDropterm"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
            "CARGO_HOME": "/run/build/cosmic-ext-dropterm/cargo"
        }
    },
    "modules": [
        {
            "name": "cosmic-ext-dropterm",
            "buildsystem": "simple",
            "build-commands": [
                "cargo --offline fetch --manifest-path Cargo.toml --verbose",
                "cargo build --offline --release -p cosmic-ext-dropterm --verbose",
                "install -Dm755 target/release/cosmic-ext-dropterm /app/bin/cosmic-ext-dropterm",
                "install -Dm644 res/io.github.l1br3_io.CosmicExtDropterm.desktop /app/share/applications/io.github.l1br3_io.CosmicExtDropterm.desktop",
                "install -Dm644 res/io.github.l1br3_io.CosmicExtDropterm.metainfo.xml /app/share/metainfo/io.github.l1br3_io.CosmicExtDropterm.metainfo.xml",
                "install -Dm644 res/icons/hicolor/scalable/apps/io.github.l1br3_io.CosmicExtDropterm.svg /app/share/icons/hicolor/scalable/apps/io.github.l1br3_io.CosmicExtDropterm.svg"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/l1br3-io/cosmic-ext-dropterm/releases/download/v0.3.1/v0.3.1.tar.gz",
                    "sha256": "ca2e5d99c1ab931ef591a706073ef3f2dca6fa4a48444eb1f38aa05c76e66192"
                },
                "cargo-sources.json"
            ]
        }
    ]
}
